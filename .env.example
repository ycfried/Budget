# Household Budget — environment template (PLACEHOLDERS ONLY — never put real secrets here)
# Copy to .env for local development. Production secrets belong in the hosting
# provider's server-side secret store, never in source control, logs, or chat.
# This prototype does not read .env at all; it is provided for the production path.

# Server
PORT=8080
NODE_ENV=development

# Database (production path only — not used by this prototype)
# DATABASE_URL=postgres://user:password@host:5432/household_budget

# Sessions / auth (production path only — the prototype uses local demo auth)
# SESSION_SECRET=generate-a-long-random-value-and-store-it-server-side-only
# INVITE_TOKEN_SECRET=generate-a-long-random-value-and-store-it-server-side-only

# Ingestion (production path only — owner approval required before any live step)
# INGEST_HMAC_SECRET=rotating-secret-for-signed-alert-events
# DEDICATED_INBOX_ADDRESS=
# FORWARDING_ALLOWLIST_ADDRESS=

# Plaid (production path only — verify Trial eligibility first; do not assume free)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_WEBHOOK_VERIFICATION_KEY=
